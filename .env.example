# 复制为 .env 并填入配置
#   cp .env.example .env
#
# ============================================================
#  方案：Qwen Realtime（对话）+ Azure Speech（发音评测）
#
#  为什么不用 Azure OpenAI：中国大陆个人账号无法部署，
#  会返回 CannotDeployDueToLocalRegulations（需营业执照）。
#  Azure Speech 的发音评测不受此限制，个人可用。
# ============================================================


# ---------- 对话层：阿里云百炼 Qwen Realtime ----------
# 1) 去 https://bailian.console.aliyun.com/ 注册（个人可开通）
# 2) 控制台 → API-KEY → 创建，得到 sk- 开头的 key
DASHSCOPE_API_KEY=sk-your-key-here

# 3) 业务空间 ID —— 注意这不是你的账号 ID！
#    控制台 → 业务空间管理 → 复制「业务空间 ID」
#    它是 URL / 事件里出现的那个标识
QWEN_WORKSPACE_ID=your-workspace-id

# 4) 区域：北京 cn-beijing（默认）/ 新加坡 ap-southeast-1
QWEN_REGION=cn-beijing

# 5) 【语音对话模型】负责"听懂并回话"
#    qwen3.8-omni-flash-realtime  最新，推荐
#    qwen3.5-omni-plus-realtime   更强
#    qwen3.5-omni-flash-realtime  上一代
QWEN_MODEL=qwen3.8-omni-flash-realtime

# 6) 【语音转写模型】只负责"把用户说的话变成文字"
#    用于屏幕上的字幕、语法纠错、入库。和上面那个是两件事。
#    一般不用改；若你的账号没开通这个模型，可换成同系列的其他型号。
QWEN_ASR_MODEL=qwen3-asr-flash-realtime

# 7) 音色：Tina / Cherry / Ethan / Chelsie 等
QWEN_VOICE=Tina


# ---------- 会话节奏 ----------
# 一次练习的时长（分钟）
SESSION_MINUTES=30

# 【AI 找话题次数上限】卡壳时按 C 键请 AI 找话题，一轮最多几次。
#   防止一直按把一个会话变成 AI 独角戏。0 = 关掉这个功能（按 C 键无效）。
IDLE_NUDGE_MAX=6


# ============================================================
#  文本模型：材料准备 / 语法纠错 / 学习画像
#
#  ⚠️ 这一组和上面的语音模型是**互相独立**的。
#     材料准备（分析主题、规划话题）用的是文本模型，不是语音模型，
#     所以两者都要能用：
#       - 语音模型 → 决定能不能对话
#       - 文本模型 → 决定能不能准备材料和纠错
#
#  好消息：百炼里这两个共用同一个 API Key 和同一个额度池，
#  不需要分别申请、也不需要额外的 key。
# ============================================================

# 【文本模型】材料准备 / 纠错 / 画像都用它
#   可选：qwen-plus（均衡，默认）/ qwen-max（更强，更贵）/ qwen-turbo（更快，更便宜）
TEXT_MODEL=qwen-plus

# 【文本接口地址】OpenAI 兼容模式，一般不用改。
#   如果换用别的厂商（任何 OpenAI 兼容的服务），把这里和
#   TEXT_MODEL 一起改掉即可，DASHSCOPE_API_KEY 也要换成对方的 key。
TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# ---------- 评测层：Azure Speech（第二阶段）----------
# 发音评测属于 Azure Speech（Cognitive Services），
# 不走 Azure OpenAI 的准入限制，个人账号可用。
# 创建 "Speech" 资源后填这里：
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus


# ---------- 代理（本机常开，必须保留）----------
# github.com 直连不可达、aka.ms 被劫持到 Bing。
# 注意：Qwen 是国内服务，直连即可；若走代理反而可能失败。
# 下面的 no_proxy 确保阿里云域名不走代理。
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
ALL_PROXY=socks5://127.0.0.1:7891
NO_PROXY=aliyuncs.com,aliyun.com,localhost,127.0.0.1


# ============================================================
#  以下为 Azure OpenAI 配置（当前不可用，仅作留档）
#  实测：CannotDeployDueToLocalRegulations
#  中国大陆只有持营业执照的企业客户能订阅 Azure OpenAI。
# ============================================================
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_DEPLOYMENT=gpt-realtime-mini
